{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mojipx-bgm-shower",
  "compatibility_date": "2026-10-01",
  // Static assets only: the music and visuals are generated in the browser, so there is no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
