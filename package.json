{
  "name": "mojipx-bgm-shower",
  "version": "0.1.0",
  "private": true,
  "description": "Endless original chiptune with full-screen pixel-art visuals, picked by your mood.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "e2e": "playwright test",
    "complexity": "cccc src",
    "similarity": "similarity-ts src --threshold 0.92 --min-lines 6 --fail-on-duplicates",
    "loudness": "node scripts/measure-loudness.ts && biome format --write src/content/songs/loudness.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "mojipx": "file:../mojipx",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
